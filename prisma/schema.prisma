generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  READY
  APPLIED
  ASSESSMENT
  INTERVIEW
  OFFER
  REJECTED
  ARCHIVED
}

model Resume {
  id        String   @id @default(cuid())
  name      String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions ResumeVersion[]
}

model ResumeVersion {
  id        String   @id @default(cuid())
  name      String
  summary   String
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumeId String
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobId    String?
  job      Job?   @relation(fields: [jobId], references: [id], onDelete: SetNull)

  applications Application[]
  interviews   InterviewSession[]
}

model Job {
  id        String   @id @default(cuid())
  company   String
  title     String
  city      String
  source    String
  jd        String
  link      String
  deadline  DateTime?
  tags      Json
  analysis  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions     ResumeVersion[]
  applications Application[]
  interviews   InterviewSession[]
}

model Application {
  id               String            @id @default(cuid())
  status           ApplicationStatus @default(READY)
  appliedAt        DateTime?
  stageDate        DateTime?
  priority         String            @default("NORMAL")
  nextFollowUpAt   DateTime?
  notes            String            @default("")
  interviewRound   String            @default("")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  jobId           String
  job             Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersionId String?
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)

  followUps FollowUpLog[]
}

model FollowUpLog {
  id        String   @id @default(cuid())
  type      String
  content   String
  createdAt DateTime @default(now())

  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model InterviewSession {
  id                   String   @id @default(cuid())
  mode                 String   @default("comprehensive")
  status               String   @default("IN_PROGRESS")
  context              Json?
  questions            Json
  answers              Json
  feedback             Json
  currentQuestionIndex Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  completedAt          DateTime?

  jobId           String
  job             Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeVersionId String?
  resumeVersion   ResumeVersion? @relation(fields: [resumeVersionId], references: [id], onDelete: SetNull)
}

model Settings {
  id               String    @id @default("singleton")
  provider         String    @default("openai-compatible")
  model            String    @default("deepseek-v4-flash")
  baseUrl          String    @default("https://api.deepseek.com/v1")
  aiProvider       String    @default("deepseek")
  aiModel          String    @default("deepseek-v4-flash")
  aiBaseUrl        String    @default("https://api.deepseek.com/v1")
  aiApiKey         String    @default("")
  aiEnabled        Boolean   @default(false)
  aiTemperature    Float     @default(0.3)
  aiLastTestedAt   DateTime?
  aiLastTestStatus String    @default("untested")
  updatedAt        DateTime  @updatedAt
}

model CareerProfile {
  id              String   @id @default("singleton")
  name            String   @default("")
  targetRoles     Json
  education       String   @default("")
  currentPosition String   @default("")
  summary         String   @default("")
  strengths       Json
  weaknesses      Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CareerProject {
  id             String   @id @default(cuid())
  name           String
  status         String   @default("active")
  description    String   @default("")
  techStack      Json
  highlights     Json
  resumeBullets  Json
  interviewStory String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CareerSkill {
  id               String   @id @default(cuid())
  name             String
  category         String   @default("general")
  level            String   @default("learning")
  evidence         String   @default("")
  learningPriority String   @default("medium")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model CareerJdAnalysis {
  id                String   @id @default(cuid())
  company           String
  role              String
  source            String   @default("")
  jdText            String
  responsibilities  Json
  requiredSkills    Json
  bonusPoints       Json
  matchedProjects   Json
  skillGaps         Json
  matchScore        Int      @default(0)
  resumeSuggestions Json
  interviewTips     Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  learningTasks CareerLearningTask[]
}

model CareerLearningTask {
  id             String   @id @default(cuid())
  title          String
  description    String   @default("")
  relatedSkill   String   @default("")
  priority       String   @default("medium")
  dayIndex       Int
  estimatedTime  String   @default("60 min")
  outputRequired String   @default("")
  status         String   @default("todo")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  jdAnalysisId String
  jdAnalysis   CareerJdAnalysis @relation(fields: [jdAnalysisId], references: [id], onDelete: Cascade)
}

model CareerExportLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  filePath   String
  createdAt  DateTime @default(now())
}
